# Copy to .env and fill in. Never commit .env.
# CONFIG_DIR=                  # optional: load profiles, accounts and workers from another folder (default: ./config)
# Passwords are used by docker-compose.yml and must match the two URLs below.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
DATABASE_URL=postgresql+pg8000://factory:CHANGE_ME@postgres:5432/factory
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=          # only if a profile's selection.llm_judge uses provider: openai_compatible
GEMINI_KEY=                  # the names a profile's selection.llm_judge.api_key_env points at (see config/profiles/mlbb.yaml)
OPEN_ROUTER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=        # your numeric Telegram user id
YOUTUBE_DATA_API_KEY=          # scout only: a Google Cloud API key (restricted to YouTube Data API v3), not an OAuth token
META_APP_ID=                   # the Meta developer app used for Facebook Page and Instagram publishing
META_APP_SECRET=               # only to exchange a short-lived token for a long-lived one; never commit it
TIKTOK_CLIENT_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
TIKTOK_CLIENT_SECRET=          # never commit; never embed in a public repo
IG_TEST_TOKEN=
IG_TEST_USER_ID=
FB_TEST_PAGE_TOKEN=
FB_TEST_PAGE_ID=
IG_MLBB_TOKEN=
IG_MLBB_USER_ID=
FB_MLBB_PAGE_TOKEN=
FB_MLBB_PAGE_ID=

# The user and group that own ./tokens (run `id -u` and `id -g`); only the YouTube publisher runs as them.
# Leave these out if they are both 1000.
# TOKENS_UID=1000
# TOKENS_GID=1000

# Cloudflare R2 (optional): keeps approved TikTok clips for a while so you get a download link and a Delete button in
# Telegram instead of a 50 MB-limited file. Free tier 10 GB. In the Cloudflare dashboard: R2 > create a bucket (private),
# then R2 > Manage API tokens > create a token with "Object Read & Write" for that bucket. It shows the Access Key ID and
# the Secret Access Key once (copy them now); the Account ID is on the R2 overview page. Leave all four empty to skip R2.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
